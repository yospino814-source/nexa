# Copiar a .env en el VPS y llenar. El archivo .env nunca se sube a git.

# Dominio ya apuntando a la IP del VPS, sin https://
DOMINIO=app.ejemplo.com

# Supabase > Project Settings
SUPABASE_URL=https://TU-PROYECTO.supabase.co
# Clave publica "sb_publishable_...". Nunca la clave secreta.
SUPABASE_PUBLISHABLE_KEY=

# Supabase > Connect > Session pooler. Contiene la clave de la base: secreto.
DATABASE_URL=

DB_MAX_CONNECTIONS=10
RUST_LOG=info
