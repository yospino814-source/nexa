SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=

DATABASE_URL=

# Pedidos por WhatsApp (Cloud API de Meta). Sin VERIFY_TOKEN y APP_SECRET el webhook responde 503.
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_GRAPH_VERSION=v21.0

# Solo si el backend está detrás de un proxy propio (Next, Cloudflare, Railway)
# que agrega X-Forwarded-For: así se usa la IP real del cliente en el límite de
# intentos de login. Sin proxy, dejarlo vacío (si no, la IP se puede falsificar).
TRUST_PROXY=

# Facturación electrónica (documento equivalente POS y notas crédito).
# Token de MATIAS API (Personal Access Token). Sin él, solo funciona el modo SIMULADO.
MATIAS_API_TOKEN=
# Vacío = sandbox (https://sandbox-api.matias-api.com/api/ubl2.1). En producción, la URL del contrato.
MATIAS_API_URL=
# "0" apaga el proceso que envía los documentos (por ejemplo, si corrés varias copias del backend).
FISCAL_WORKER=
