# Copiar a .env.local (no se sube al repo).

# --- Supabase Auth (login) ---------------------------------------------------
# Dashboard de Supabase > Project Settings > API.
# Solo la clave PUBLICA (publishable "sb_publishable_..." o la "anon" legacy).
# NUNCA pongas aqui la service_role / secret key: esto llega al navegador.
# Sin estas dos variables la app corre en modo demo, sin login.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# --- Backend Rust -------------------------------------------------------------
# URL del backend (solo servidor). El navegador llama a /api/* y Next reenvia.
BACKEND_URL=http://localhost:8080

# "true" = usar el backend real. Vacio = datos mock.
NEXT_PUBLIC_USE_BACKEND=
